#
# This Service captures kernel and OpenHD logs from the previous boot,
# then stores them in /Config/openhd/logs for post-crash debugging.
#

[Unit]
Description=OpenHD crash dump capture
After=systemd-journald.service local-fs.target
Wants=systemd-journald.service
ConditionPathExists=/Config

[Service]
Type=oneshot
ExecStart=/usr/local/bin/openhd-crashdump.sh

[Install]
WantedBy=multi-user.target
