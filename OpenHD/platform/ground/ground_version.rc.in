#include <windows.h>

1 VERSIONINFO
FILEVERSION @OPENHD_GROUND_VERSION_CSV@,0
PRODUCTVERSION @OPENHD_GROUND_VERSION_CSV@,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "OpenHD"
            VALUE "FileDescription", "OpenHD Ground"
            VALUE "FileVersion", "@OPENHD_GROUND_VERSION@"
            VALUE "ProductName", "OpenHD"
            VALUE "ProductVersion", "@OPENHD_GROUND_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
